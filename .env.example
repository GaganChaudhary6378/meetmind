# Copy this file to .env and fill in real values. Never commit .env.

# --- Slack (chat surface, phase 1) ---
# Bot token, starts with xoxb- (OAuth & Permissions page)
SLACK_BOT_TOKEN=xoxb-your-bot-token
# App-level token, starts with xapp- (needed for Socket Mode)
SLACK_APP_TOKEN=xapp-your-app-token
# Signing secret (Basic Information page)
SLACK_SIGNING_SECRET=your-signing-secret
# Channel ID the chat-archiver reads from for shared org knowledge.
# Get it from the channel's "About" panel in Slack (starts with C).
SLACK_SHARED_KNOWLEDGE_CHANNEL_ID=C0XXXXXXX

# --- Supermemory (memory layer) ---
# General key — used for private-memory reads/writes (task 1.1) and
# read-only shared-memory queries (task 1.3).
SUPERMEMORY_API_KEY=sm_your_api_key
# Scoped key restricted to the org_shared container tag. Only ingestion
# jobs (codebase indexer, chat archiver) use this. Leave blank until an
# ingestion job needs to write — writes without it will fail loudly.
SUPERMEMORY_SHARED_WRITE_API_KEY=
SUPERMEMORY_BASE_URL=https://api.supermemory.ai
SHARED_CONTAINER_TAG=org_shared

# --- LLM routing (OpenRouter) ---
OPENROUTER_API_KEY=sk-or-your-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Strong/low-latency model for live, high-stakes answers (said out loud).
LLM_MODEL_ANSWER=openai/gpt-4.1
# Cheap/small model for summarization and facilitator-summary calls.
# Dev/test only, do not use on real private data: openrouter/x-ai/ox-alpha:free (unnamed provider, short preview window)
LLM_MODEL_SUMMARY=openai/gpt-4.1-mini
# Explicit output cap. Without this, OpenRouter defaults to the model's
# max output tokens, which can exceed a low-balance account's credits
# and fail with a 402. Lower further if you still hit 402s.
LLM_MAX_TOKENS=800
# If one provider is busy/rate-limited, OpenRouter auto-retries the next
# provider for the same model. See openrouter.ai/docs/features/provider-routing
LLM_ALLOW_FALLBACKS=true
# Optional preferred provider order, comma-separated (e.g. "openai,azure").
# Leave blank to let OpenRouter pick. Add your own provider key at
# openrouter.ai/settings/integrations if you want a specific provider
# to be tried first/only.
LLM_PROVIDER_ORDER=

# --- Retrieval confidence gate (plan §6) ---
# Below this score, the agent says "not sure" instead of guessing live.
# 0.90 is the plan's target once tuned; start lower (0.50) since real
# cosine-similarity scores rarely reach 0.90 against short queries.
CONFIDENCE_THRESHOLD=0.50

# --- Gmail (transcript ingestion, task M1) ---
# Per-user OAuth app, from console.cloud.google.com (OAuth client ID,
# type "Desktop app"). Reads only the connecting user's own mailbox —
# not domain-wide delegation.
GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-client-secret
# Refresh token from a one-time local OAuth consent flow (run the
# `google-auth-oauthlib` InstalledAppFlow once, save the refresh_token
# it returns — see README §Gmail setup).
GMAIL_REFRESH_TOKEN=
# Gmail search query to find transcript emails — scoped to Google
# Meet's auto-transcript sender.
GMAIL_TRANSCRIPT_QUERY=from:noreply-meet@google.com

# --- Voice loop (phase 3, tasks 3.1-3.5, pipecat-backed — app/voice/bot.py) ---
# Phrase pipecat's wake-phrase turn strategy (3.2) listens for to
# trigger a live answer.
AGENT_NAME=Agent
# faster-whisper model size, used by pipecat's WhisperSTTService (3.1).
# "base" is a reasonable CPU default; raise to "small"/"medium" if
# accuracy is too low for real use.
STT_MODEL_SIZE=base
# NOT currently wired up — pipecat's WhisperSTTService does not expose
# faster-whisper's initial_prompt vocabulary-biasing param, so this has
# no effect right now. Kept for a future pipecat version or custom
# subclass that adds it back.
STT_VOCAB_HINT=auth, migration, PTO, Jira, Slack, Supermemory, standup
# Kokoro voice id, used by pipecat's KokoroTTSService (3.5). "af_heart"
# is a built-in American-English voice — see github.com/hexgrad/kokoro
# for the full voice list.
TTS_VOICE=af_heart
# kokoro-onnx model files, used by pipecat's KokoroTTSService. Optional
# — if unset/missing, pipecat auto-downloads them to
# ~/.cache/pipecat/kokoro-onnx on first use (same files, same GitHub
# release URLs). Fetch manually to control where they land — see
# README §7.
KOKORO_MODEL_PATH=kokoro-v1.0.onnx
KOKORO_VOICES_PATH=voices-v1.0.bin

# --- A2A (agent-to-agent, phase 2 facilitator mode) ---
# Host each PersonAgent's A2A server binds to (local dev: 127.0.0.1).
A2A_AGENT_HOST=127.0.0.1
# Team roster, "slack_user_id:port,slack_user_id:port,...". Each
# teammate runs their own PersonAgent A2A server on their own port
# (see `python -m app.agents.a2a_server <user_id> <port>`); the
# facilitator (/standup) looks up each teammate's URL here.
A2A_TEAM_ROSTER=U0ALICE:9001,U0BOB:9002

# --- App ---
LOG_LEVEL=INFO
